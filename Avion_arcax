def apply_upgrade(idx):
    global next_upgrade_at
    key = ("shot", "firerate")[idx]
    if upgrade_levels[key] < UPGRADE_MAX_LEVEL:
        upgrade_levels[key] += 1
    next_upgrade_at += 30
    save_progress()
    play_sfx(sfx_levelup)

