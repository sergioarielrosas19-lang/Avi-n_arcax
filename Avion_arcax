def load_sfx():
    global sfx_shoot, sfx_explosion, sfx_levelup, sfx_player_death
    def try_load(path, vol=0.7):
        if not pygame.mixer.get_init():
            return None
        if not os.path.exists(path):
            return None
        try:
            s = pygame.mixer.Sound(path)
            s.set_volume(vol)
            return s
        except Exception:
            return None
    sfx_shoot = try_load(SFX_SHOOT_FILE, 0.45)
    sfx_explosion = try_load(SFX_EXPLOSION_FILE, 0.6)
    sfx_levelup = try_load(SFX_LEVELUP_FILE, 0.7)
    sfx_player_death = try_load(SFX_PLAYER_DEATH_FILE, 0.8)

def play_sfx(snd):
    if snd:
        try:
            snd.play()
        except Exception:
            pass

