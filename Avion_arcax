# ---------------- UI / DRAW ----------------
def draw_background_and_stars(dt, lvl):
    top, bottom = BG_PALETTES[(lvl-1) % len(BG_PALETTES)]
    for y in range(0, HEIGHT, 12):
        t = y / HEIGHT
        r = int(top[0] * (1-t) + bottom[0] * t)
        g = int(top[1] * (1-t) + bottom[1] * t)
        b = int(top[2] * (1-t) + bottom[2] * t)
        pygame.draw.rect(screen, (r,g,b), (0, y, WIDTH, 12))
    for s in stars:
        s["y"] += s["speed"] * (dt/16) * (1 + lvl*0.02)
        s["phase"] += 0.07 * (dt/16)
        if s["y"] > HEIGHT + 6:
            s["y"] = -6; s["x"] = random.randrange(0, WIDTH)
        flick = int(25 * math.sin(s["phase"]))
        v = max(80, min(255, s["bright"] + flick))
        col = (v,v,v)
        if s["size"] <= 1:
            screen.fill(col, (int(s["x"]), int(s["y"]), 1, 1))
        else:
            pygame.draw.circle(screen, col, (int(s["x"]), int(s["y"])), s["size"])

def draw_player():
    screen.blit(player_surf, (player.x, player.y))
    if shield > 0 and pygame.time.get_ticks() - shield_start_time < compute_shield_duration():
        pygame.draw.circle(screen, (0,150,255), player.center, 40, 3)

def make_boss_surf_for_level(lv, size, t):
    variant = lv % 4
    surf = pygame.Surface((size*2, size*2), pygame.SRCALPHA)
    pulse = 1.0 + 0.06 * math.sin(t * 0.006 + lv)
    if variant == 0:
        for i in range(size, 0, -4):
            col = (200, 40 + (lv*6) % 120, 80 + (i % 40))
            r = int(i * pulse)
            pygame.draw.circle(surf, col, (size,size), max(1, r))
        pygame.draw.circle(surf, (255,255,255), (size - size//3, size - size//4), max(4, size//8))
        pygame.draw.circle(surf, (255,255,255), (size + size//3, size - size//4), max(4, size//8))
    elif variant == 1:
        pts = [(size, 0), (size*2, size), (size, size*2), (0, size)]
        color = ((60 + lv*10) % 255, (30 + lv*6) % 255, 160)
        pygame.draw.polygon(surf, color, pts)
        pygame.draw.polygon(surf, (0,0,0), pts, 3)
    elif variant == 2:
        col = ((20 + lv*12) % 255, 160, (120 + lv*8) % 255)
        pygame.draw.ellipse(surf, col, (int(size*0.1), int(size*0.3), int(size*1.8), int(size*0.9)))
        pygame.draw.circle(surf, (0,0,0), (size, int(size*0.8)), max(6, size//8))
    else:
        base = ((100 + lv*12) % 255, (60 + lv*8) % 255, (200 - lv*6) % 255)
        for a in range(0, 360, 20):
            rad = math.radians(a)
            x = size + math.cos(rad) * (size * 0.95)
            y = size + math.sin(rad) * (size * 0.95)
            pygame.draw.circle(surf, base, (int(x), int(y)), max(6, size//10))
        pygame.draw.circle(surf, (0,0,0), (size,size), max(6,size//6))
    return surf

