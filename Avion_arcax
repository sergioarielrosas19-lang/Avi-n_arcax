    allies.clear(); ally_bullets.clear(); boss_minions.clear()
    boss = None
    boss_active = False
    boss_hp = 0.0
    boss_max_hp = 0.0
    boss_pending_spawn = False

def spawn_enemy():
    max_enemies = min(140, BASE_MAX_ENEMIES + level * 3)
    if level == 1:
        max_enemies = min(200, BASE_MAX_ENEMIES + EXTRA_ENEMIES_LEVEL1)
    if len(enemies) >= max_enemies:
        return
    w = random.randint(30,56)
    x = random.randint(18, WIDTH - 18 - w)
    rect = pygame.Rect(x, -w - random.randint(0,80), w, w)
    etype = random.randrange(len(enemy_surfs))
    hp = 1 + level//4 + (1 if etype == 2 else 0)
    speed = 1.2 + level * 0.12 + random.random() * 0.9
    enemies.append({"rect": rect, "hp": hp, "speed": speed, "type": etype, "shot_done": False})

def enemy_shoot(e):
    if e.get("shot_done", False):
        return
    angle = math.atan2(player.centery - e["rect"].centery, player.centerx - e["rect"].centerx)
    sp = 4 + level * 0.18
    if len(enemy_bullets) < MAX_ENEMY_BULLETS:
        enemy_bullets.append({"x": e["rect"].centerx, "y": e["rect"].centery, "dx": math.cos(angle)*sp, "dy": math.sin(angle)*sp})
    e["shot_done"] = True

def spawn_drop(x,y,drop_type=None):
    drops.append({"type": drop_type, "rect": pygame.Rect(int(x)-13, int(y)-13, 26, 26)})

def spawn_boss_minions_for_level(lv, boss_rect):
    global boss_minions
    boss_minions = []
    count = 2 + lv // 3
    for i in range(count):
        angle_off = (i / max(1, count)) * math.tau
        orbit = boss_rect.width//2 + 36 + i*14
        size = 28
        rect = pygame.Rect(int(boss_rect.centerx + math.cos(angle_off)*orbit)-size//2,
                           int(boss_rect.centery + math.sin(angle_off)*orbit)-size//2,
                           size, size)
        boss_minions.append({"rect": rect, "hp": 8 + lv*2, "angle_off": angle_off, "orbit": orbit, "last_shot": 0, "phase": random.random()})

def spawn_boss_for_level(lv):
    global boss, boss_hp, boss_max_hp, boss_active, boss_last_attack, boss_pending_spawn, invulnerable_until, allies, unlocked_levels
    boss_active = True
    boss_pending_spawn = False
    size = 44 + lv * 8
    if lv >= MAX_LEVEL:
        boss_hp_val = 900 + lv * 220
    else:
        boss_hp_val = 140 + lv * 120
    boss_hp_val = int(boss_hp_val)
    boss_hp = float(boss_hp_val)
    boss_max_hp = float(boss_hp_val)
    boss = {"rect": pygame.Rect(WIDTH//2 - size, 90, size*2, size*2), "size": size, "level": lv}
    boss_last_attack = pygame.time.get_ticks()
    invulnerable_until = pygame.time.get_ticks() + INVULN_ON_BOSS_SPAWN
    # limpias balas peligrosas y efectos visuales
    safe = []
    for eb in enemy_bullets:
        dx = eb["x"] - player.centerx; dy = eb["y"] - player.centery
        if math.hypot(dx,dy) > 110:
            safe.append(eb)
    enemy_bullets[:] = safe
    spawn_particles(WIDTH//2, boss["rect"].centery, (255,200,80), 28, spread=28, vel=2.2)
    spawn_boss_minions_for_level(lv, boss["rect"])
    if lv >= MAX_LEVEL:
        spawn_allies()
    # sfx de aparición de jefe / fanfarria
    play_sfx(sfx_levelup)

