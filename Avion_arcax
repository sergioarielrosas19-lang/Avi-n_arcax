def boss_trigger_for_level(lv):
    return max(6, 6 + lv*4)

def restart_level(full_reset_lives=True):
    global bullets, enemy_bullets, enemies, drops, boss, boss_active, boss_hp, boss_max_hp, boss_pending_spawn, boss_pending_since, allies, ally_bullets, boss_minions, total_kills, enemy_kills_for_boss, shield, shield_start_time, invulnerable_until, lives
    bullets = []
    enemy_bullets = []
    enemies = []
    drops = []
    allies = []
    ally_bullets = []
    boss_minions = []
    boss = None
    boss_active = False
    boss_hp = 0.0
    boss_max_hp = 0.0
    boss_pending_spawn = False
    boss_pending_since = 0
    total_kills = 0
    enemy_kills_for_boss = 0
    shield = 0.0
    shield_start_time = pygame.time.get_ticks()
    if full_reset_lives:
        lives = MAX_LIVES
    invulnerable_until = pygame.time.get_ticks() + INVULN_ON_LEVEL_START
    init_stars()

def start_level(new_level):
    global level
    level = new_level
    restart_level(full_reset_lives=True)
    save_progress()

def retry_level():
