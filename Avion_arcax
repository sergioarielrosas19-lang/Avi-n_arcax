        screen.blit(sub, (WIDTH//2 - sub.get_width()//2, HEIGHT//2 + 80))
        hint = font.render("Toca para volver al menú principal", True, (180,180,180))
        screen.blit(hint, (WIDTH//2 - hint.get_width()//2, HEIGHT//2 + 140))
        for pos in mouse_down_positions:
            clear_playing_entities(); screen_state = "menu"

    pygame.display.flip()

# on exit save
save_progress()
pygame.quit()
sys.exit()