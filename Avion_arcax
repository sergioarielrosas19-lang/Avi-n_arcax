# ---------------- SAVE / LOAD ----------------
def load_progress():
    global level, score, upgrade_levels, next_upgrade_at, unlocked_levels
    if os.path.exists(SAVE_FILE):
        try:
            with open(SAVE_FILE, "r") as f:
                data = json.load(f)
                level = max(1, min(int(data.get("level", 1)), MAX_LEVEL))
                score = int(data.get("score", 0))
                ul = data.get("upgrades", {})
                upgrade_levels["shot"] = int(ul.get("shot", 0))
                upgrade_levels["firerate"] = int(ul.get("firerate", 0))
                next_upgrade_at = int(data.get("next_upgrade_at", next_upgrade_at))
                unlocked_levels = int(data.get("unlocked_levels", unlocked_levels))
                unlocked_levels = max(1, min(unlocked_levels, MAX_LEVEL))
        except Exception:
            level = 1; score = 0; upgrade_levels = {"shot":0,"firerate":0}; next_upgrade_at = 20; unlocked_levels = 1
    else:
        level = 1; score = 0; unlocked_levels = 1

def save_progress():
    try:
        with open(SAVE_FILE, "w") as f:
            json.dump({
                "level": level,
                "score": score,
                "upgrades": upgrade_levels,
                "next_upgrade_at": next_upgrade_at,
                "unlocked_levels": unlocked_levels
            }, f)
    except Exception:
        pass

